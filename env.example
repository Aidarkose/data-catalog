# ============================================================
# OMEGA-3 — environment overrides (optional — all have defaults)
# Copy to .env to override
# ============================================================

# Airflow
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0jP6bEY=
AIRFLOW_JWT_SECRET=omega3-jwt-dev-secret-change-me-46bkj

# OpenSearch JVM
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ============================================================
# AI Chat (Gemini + OpenMetadata MCP/REST tools)
# ============================================================
# Google AI Studio API key — https://aistudio.google.com/apikey (Free tier)
GEMINI_API_KEY=

# Какую модель Gemini использовать. На free-tier работают:
#   gemini-2.5-flash (рекомендуется — лучшее качество tool-calling в free-tier),
#   gemini-2.5-flash-lite, gemini-flash-latest, gemini-flash-lite-latest.
# gemini-2.0-flash на free-tier недоступен (limit=0).
GEMINI_MODEL=gemini-2.5-flash

# JWT bot-юзера для OM MCP — заполняется автоматически скриптом
# scripts/setup_ai_chat.py. Без этого чат работает в REST-режиме.
OM_BOT_JWT=

# Транспорт MCP: streamable_http (по умолчанию в OM 1.12) или sse
OM_MCP_TRANSPORT=streamable_http
