FROM apache/airflow:3.0.2-python3.12

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl libpq-dev gcc build-essential \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Providers for Airflow 3.0 + Postgres + OpenLineage
RUN pip install --no-cache-dir \
      "apache-airflow-providers-postgres" \
      "apache-airflow-providers-http" \
      "apache-airflow-providers-openlineage"

# dbt-metricflow 0.11.0 requires dbt-core~=1.10; install it first so that
# openmetadata-ingestion does not downgrade it further.
# dbt-postgres 1.9.0 is the latest adapter that pip resolves without conflict.
RUN pip install --no-cache-dir \
      "dbt-core==1.10.20" \
      "dbt-postgres==1.9.0" \
      "dbt-metricflow[dbt-postgres]==0.11.0"

# OpenMetadata ingestion 1.12 (installed last — it may upgrade dbt-core within 1.10.x).
# `collate-dbt-artifacts-parser` is required by OM 1.12 for dbt lineage ingestion
# (the public `dbt-artifacts-parser` is NOT sufficient despite similar name).
RUN pip install --no-cache-dir \
      "openmetadata-ingestion[postgres]==1.12.5.3" \
      "collate-dbt-artifacts-parser>=0.1"
